{
  "name": "obspace-desktop",
  "version": "1.5.0-beta",
  "private": true,
  "description": "Obspace desktop nativo: grafo 3D Obsidian, chat-first, Ollama e AI2AI.",
  "main": "electron/main.cjs",
  "author": "Obspace",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev/dev.cjs",
    "start": "electron .",
    "build": "node scripts/dev/vite-runner.cjs build",
    "dist": "npm run build && electron-builder",
    "release:desktop": "npm run dist && node scripts/windows/publish-desktop-release.cjs",
    "check": "node --check electron/main.cjs && node --check electron/bootstrap/main-process.cjs && node --check electron/bootstrap/register-ipc.cjs && node --check electron/preload.cjs && node --check electron/services/graph.cjs && node --check electron/services/ollama.cjs && node --check electron/services/attachments.cjs && node --check electron/services/ai2ai.cjs && node --check electron/services/runtime-settings.cjs && npm run build",
    "icon": "python scripts/assets/generate-icon.py",
    "shortcut": "node scripts/windows/create-desktop-shortcut.cjs"
  },
  "dependencies": {
    "@mediapipe/camera_utils": "^0.3.1675466862",
    "@mediapipe/hands": "^0.4.1675469240",
    "3d-force-graph": "^1.79.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.8.0",
    "pdf-parse": "^1.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "vite": "^7.1.7"
  },
  "build": {
    "appId": "com.obspace.desktop",
    "productName": "Obspace",
    "artifactName": "Obspace.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Obspace"
    }
  }
}
